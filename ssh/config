Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host github.com-victoria-id
    HostName github.com
    User git
    IdentityFile ~/.ssh/victoria-github
    IdentitiesOnly yes

# Per-repository aliases of the work identity, e.g. the `pdf-lib` dependency in
# victoria_connect_api's package.json: `git@pdf-lib.github.com.alias.victoria-id.com:..`.
# The wildcard covers every repository, so none needs an entry of its own.
Host *.github.com.alias.victoria-id.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/victoria-github
    IdentitiesOnly yes
