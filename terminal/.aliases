#!/bin/bash

# ─── Basic Navigation ────────────────────────────────────────────────────────
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'

# ─── Git Workflows ───────────────────────────────────────────────────────────

# Amend last commit with current staged changes
amend() {
  git add . && git commit --amend --no-edit
}

# Force push the current branch, but fail instead of clobbering if someone
# else pushed since your last fetch
force() {
  git push --force-with-lease
}

# Clean untracked files and reset all changes
nuke() {
    git clean -df && git reset --hard
}

# Undo last commit but keep changes staged
undo() {
  git reset --soft HEAD~1
}

# Quick stash and pop
alias stash='git stash -u'
alias pop='git stash pop'

# Work in progress commit
alias wip='git add . && git commit -m wip'
